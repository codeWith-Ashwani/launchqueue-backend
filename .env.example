# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/launchqueue

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS & Share Links)
CLIENT_URL=http://localhost:5173

# Email Delivery (Nodemailer / SMTP)
EMAIL_PROVIDER=smtp
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Free Render web services: set EMAIL_PROVIDER=brevo and EMAIL_DELIVERY_MODE=inline.
# Use a Brevo API key (not an SMTP key) and a verified sender address in EMAIL_FROM.
BREVO_API_KEY=
EMAIL_FROM_NAME=LaunchQueue
# Optional custom SMTP provider; omit EMAIL_HOST to use Gmail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=

# LemonSqueezy Payments & Webhooks
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret
LEMONSQUEEZY_STARTER_VARIANT_ID=your_starter_variant_id
LEMONSQUEEZY_PRO_VARIANT_ID=your_pro_variant_id
LEMONSQUEEZY_AGENCY_VARIANT_ID=your_agency_variant_id
LEMONSQUEEZY_TEST_MODE=false

# Optional Redis (backend only; use Render internal URL in production)
REDIS_URL=

# Use queue on the Render API and run npm run worker in a persistent worker service.
# API and worker must share MONGO_URI, REDIS_URL, CLIENT_URL and encryption secrets.
EMAIL_DELIVERY_MODE=inline
# Set a strong stable key in production; JWT_SECRET is the development fallback.
EMAIL_ENCRYPTION_KEY=

# Explicit proxy hop count; verify the deployment path before enabling forwarded IPs.
TRUST_PROXY_HOPS=0

# Optional AI campaign page designer (backend only; use an unbilled free-tier project).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_DAILY_LIMIT=20
