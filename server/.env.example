# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/launchqueue

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS & Share Links)
CLIENT_URL=http://localhost:5173

# Email Delivery (Nodemailer / SMTP)
EMAIL_PROVIDER=smtp
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Free Render web services: use brevo HTTPS delivery instead of SMTP.
# EMAIL_FROM must be the bare verified sender address when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=LaunchQueue
# Optional custom SMTP configuration; omit EMAIL_HOST to use Gmail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_DELIVERY_MODE=inline
EMAIL_ENCRYPTION_KEY=

# LemonSqueezy Payments & Webhooks
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret
LEMONSQUEEZY_STARTER_VARIANT_ID=your_starter_variant_id
LEMONSQUEEZY_PRO_VARIANT_ID=your_pro_variant_id
LEMONSQUEEZY_AGENCY_VARIANT_ID=your_agency_variant_id

# Optional Redis (backend only; use Render internal URL in production)
REDIS_URL=
TRUST_PROXY_HOPS=0
LEMONSQUEEZY_TEST_MODE=false

# Optional AI campaign page designer (backend only).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_LIMIT=20
